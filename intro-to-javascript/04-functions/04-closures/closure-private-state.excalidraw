      "text": "Each factory call creates a different count.\nDeclare it outside the returned function\nso repeated inner calls do not reset it.",
      "fontSize": 18,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each factory call creates a different count.\nDeclare it outside the returned function\nso repeated inner calls do not reset it.",
